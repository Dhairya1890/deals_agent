
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# Supabase — project URL and anon key from Settings > API
SUPABASE_URL=YOUR_SUPABASE_URL_HERE
SUPABASE_ANON_KEY=YOUR_SUPABASE_API_KEY_HERE

# Google Gemini — used for embeddings (text-embedding-004)
GOOGLE_AI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Gmail OAuth2 — create credentials at console.cloud.google.com
GMAIL_CLIENT_ID=YOUR_GMAIL_CLIENT_ID
GMAIL_CLIENT_SECRET=YOUR_GMAIL_CLIENT_SECRET
GMAIL_REFRESH_TOKEN=YOUR_REFRESH_TOKEN

# Slack — Bot token (xoxb-) for channel history; User token (xoxp-) for search
SLACK_BOT_TOKEN=YOUR_SLACK_BOT_TOKEN
SLACK_USER_TOKEN=YOUR_SLACK_USER_TOKEN

# HubSpot — private app token from Settings > Integrations > Private Apps
HUBSPOT_ACCESS_TOKEN=YOUR_HUBSPOT_ACCESS_TOKEN

# Deployed frontend URL (set after deploying frontend on Render)
FRONTEND_URL=FRONTEND_URL
